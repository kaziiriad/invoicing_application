# Production Environment Variables for Render Deployment
# Update these values with your actual production settings

# Django Settings
SECRET_KEY=your-super-secret-production-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=your-render-app-name.onrender.com,your-custom-domain.com

# Database (Render PostgreSQL)
DATABASE_URL=postgresql://username:password@hostname:port/database_name

# CORS Settings (Add your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,https://your-custom-domain.com
CORS_ALLOW_ALL_ORIGINS=False

# Static Files
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles/

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Email Settings (if needed)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Optional: Redis for caching (if using Redis on Render)
# REDIS_URL=redis://red-xxxxx:6379

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Logging
LOG_LEVEL=INFO